# Frontend local dev configuration.
#
# The Fastify API key is SERVER-ONLY: it is read by the Nitro BFF route at
# `server/routes/backend/[...path].ts` and injected into outbound requests
# to Fastify. The browser never sees this value.
#
# Keep this file as a local `.env` (gitignored) and never commit a real API key.

# Server-only: the Fastify API key used by the Nitro BFF.
NUXT_API_KEY=

# Server-only: the Fastify base URL the Nitro BFF forwards to.
NUXT_BACKEND_URL=http://127.0.0.1:3000

# Client-side (runtimeConfig.public.apiBase): the same-origin path the browser
# uses to reach the Nitro BFF.
NUXT_PUBLIC_API_BASE=/backend
{
  "name": "ai-workforce",
  "version": "0.0.1",
  "private": true,
  "description": "AI Workforce / AI Operations Automation",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "start:api": "node --env-file-if-exists=.env dist/api/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/main.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:dist": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "tenant:create": "tsx --env-file-if-exists=.env src/cli/create-tenant.ts",
    "apikey:create": "tsx --env-file-if-exists=.env src/cli/create-api-key.ts",
    "user:create": "tsx --env-file-if-exists=.env src/cli/create-user.ts",
    "workflow:create": "tsx --env-file-if-exists=.env src/cli/create-workflow.ts",
    "webhooks:inspect": "tsx --env-file-if-exists=.env src/cli/inspect-webhooks.ts",
    "runs:inspect": "tsx --env-file-if-exists=.env src/cli/inspect-run.ts",
    "runs:prune": "tsx --env-file-if-exists=.env src/cli/runs-prune.ts",
    "llm:smoke": "tsx --env-file-if-exists=.env src/cli/llm-smoke.ts",
    "llm:tool-smoke": "tsx --env-file-if-exists=.env src/cli/llm-tool-smoke.ts",
    "connections": "tsx --env-file-if-exists=.env src/cli/connections.ts",
    "slack:smoke": "tsx --env-file-if-exists=.env src/cli/slack-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsc-alias": "1.9.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

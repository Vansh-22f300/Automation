{
  "name": "ai-workforce",
  "version": "0.0.1",
  "private": true,
  "description": "AI Workforce / AI Operations Automation",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "start:api": "node --env-file-if-exists=.env dist/api/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/main.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:dist": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:check": "drizzle-kit check",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "tenant:create": "tsx --env-file-if-exists=.env src/cli/create-tenant.ts",
    "apikey:create": "tsx --env-file-if-exists=.env src/cli/create-api-key.ts",
    "workflow:create": "tsx --env-file-if-exists=.env src/cli/create-workflow.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "uuid": "^14.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

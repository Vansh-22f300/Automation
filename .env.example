# ---------------------------------------------------------------------------
# AI Workforce — environment configuration (Step 2)
#
# Copy to `.env` for local use. Every variable below is validated at process
# startup by src/config/env.ts; the process exits immediately if any value is
# invalid. Only variables actually consumed by the current code are listed —
# ANTHROPIC_API_KEY, credential encryption keys, etc. will be added when the
# features that need them are built.
#
# DATABASE_URL is REQUIRED and has no default. Everything else falls back to a
# sane value, so a .env containing only DATABASE_URL is enough.
#
# `.env` is git-ignored. Never commit real credentials — this file must only ever
# contain placeholders.
# ---------------------------------------------------------------------------

# development | test | production
# `development` enables human-readable pretty logging (requires devDependencies).
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
# `debug` additionally logs every SQL statement (never its parameters).
LOG_LEVEL=info

# API bind address. Use 0.0.0.0 when running inside a container or on a PaaS
# (Render/Railway/Fly), which must bind all interfaces to receive traffic.
# The default is 127.0.0.1 so a local dev server is not exposed to your LAN.
HOST=127.0.0.1

# API port (1-65535).
PORT=3000

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
#
# Any standard PostgreSQL connection URL. The value below is a placeholder and
# will not connect to anything — replace the credentials, host and database name
# with your own.
#
#   Local Postgres    postgresql://postgres:postgres@localhost:5432/ai_workforce
#   Neon / Supabase    copy the connection string from the dashboard
#
# Managed providers require TLS. Request it through the URL rather than a
# separate variable, by appending:  ?sslmode=require
#
# If the password contains @ : / ? # or %, percent-encode it, otherwise the URL
# will not parse and startup will fail.
DATABASE_URL=postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@localhost:5432/ai_workforce

# Maximum pooled connections per process (1-100, default 10). Two processes run
# (api and worker), so the ceiling against the server is roughly double this.
# Serverless Postgres plans cap connections tightly — lower this if you see
# "too many connections".
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Claude / Anthropic (optional — Step 7)
# ---------------------------------------------------------------------------
#
# The application boots WITHOUT these. They are only needed by code paths that
# actually call Claude; the provider validates the key when it is constructed.
#
# ANTHROPIC_API_KEY is a SECRET: it is never logged, never persisted, and never
# returned to API clients. Leave it unset unless you are exercising the LLM
# provider (e.g. `pnpm llm:smoke`). NEVER commit a real key — this file must
# only ever contain a placeholder, and `.env` is git-ignored.
#ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# The Claude model the provider defaults to when a request does not name one.
# Configurable so the model is a deployment decision; any request may override
# it. Defaults to claude-opus-5 when unset.
#ANTHROPIC_MODEL=claude-opus-5

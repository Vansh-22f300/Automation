# ---------------------------------------------------------------------------
# AI Workforce — environment configuration (Step 1)
#
# Copy to `.env` for local use. Every variable below is validated at process
# startup by src/config/env.ts; the process exits immediately if any value is
# invalid. Only variables actually consumed by the current code are listed —
# DATABASE_URL, ANTHROPIC_API_KEY, credential encryption keys, etc. will be
# added when the features that need them are built.
#
# All values below have defaults, so an empty .env (or no .env at all) works.
# ---------------------------------------------------------------------------

# development | test | production
# `development` enables human-readable pretty logging (requires devDependencies).
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# API bind address. Use 0.0.0.0 when running inside a container or on a PaaS
# (Render/Railway/Fly), which must bind all interfaces to receive traffic.
# The default is 127.0.0.1 so a local dev server is not exposed to your LAN.
HOST=127.0.0.1

# API port (1-65535).
PORT=3000
